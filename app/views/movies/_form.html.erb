<%= form_with(model: movie, local: true, html: { class: 'container' }) do |form| %>
  <% if movie.errors.any? %>
    <div id="error_explanation" class="error_explanation">
      <h2><%= pluralize(movie.errors.count, "помилок") %> завадили зберегти фільм:</h2>
      <ul>
        <% movie.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="form-group">
      <%= form.label :title, 'Назва' %>
      <%= form.text_field :title, required: true %>
    </div>

    <div class="form-group">
      <%= form.label :duration, 'Тривалість (хв)' %>
      <%= form.number_field :duration, required: true %>
    </div>

    <div class="form-group" style="flex:1 1 100%">
      <%= form.label :description, 'Опис' %>
      <%= form.text_area :description, rows: 10 %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit 'Зберегти', class: 'btn btn-primary' %>
  </div>
<% end %>
