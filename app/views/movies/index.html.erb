<h1>Movies</h1>

<%= link_to "Add New Movie", new_movie_path, class: "btn btn-primary" %>

<% if @movies.any? %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Duration (min)</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.duration %></td>
          <td><%= truncate(movie.description, length: 50) %></td>
          <td>
            <%= link_to "Show", movie_path(movie) %>
            <%= link_to "Edit", edit_movie_path(movie) %>
            <%= link_to "Delete", movie_path(movie), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No movies found.</p>
<% end %>
