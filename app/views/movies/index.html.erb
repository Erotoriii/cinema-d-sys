<h1>Фільми</h1>

<%= link_to "Додати новий фільм", new_movie_path, class: "btn btn-primary" %>

<% if @movies.any? %>
  <table>
    <thead>
      <tr>
        <th>Назва</th>
        <th>Тривалість (хв)</th>
        <th>Опис</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.duration %></td>
          <td><%= truncate(movie.description, length: 50) %></td>
          <td>
            <%= link_to "Переглянути", movie_path(movie) %>
            <%= link_to "Редагувати", edit_movie_path(movie) %>
            <%= link_to "Видалити", movie_path(movie), data: { turbo_method: :delete, turbo_confirm: "Ви впевнені?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Фільмів не знайдено.</p>
<% end %>
