<%= form_with(model: @user, url: users_path, local: true) do |form| %>
  <% if @user.errors.any? %>
    <div style="color: red; margin-bottom: 20px;">
      <h4>Помилки:</h4>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= form.label :role, "Роль" %><br>
    <%= form.select :role, User.roles.keys.map { |r| [r.humanize, r] }, {}, { id: "role_select", style: "padding: 5px;" } %>
  </div>

  <div id="admin_email_field" style="display: none; margin-bottom: 15px;">
    <%= form.label :email, "Повний Email" %><br>
    <%= form.email_field :email, name: "user[email]", style: "padding: 5px; width: 250px;" %>
  </div>

  <div id="staff_username_field" style="margin-bottom: 15px; display: flex; align-items: center;">
    <div style="margin-right: 10px;">
      <%= label_tag "user[username]", "Логін для входу" %><br>
      <%= text_field_tag "user[username]", nil, style: "padding: 5px; width: 150px;" %>
    </div>
    <div style="margin-top: 20px;">
      <strong>@<%= current_user.company&.domain_prefix %>.ua</strong>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :password, "Пароль" %><br>
    <%= form.password_field :password, style: "padding: 5px; width: 250px;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= form.label :password_confirmation, "Підтвердження пароля" %><br>
    <%= form.password_field :password_confirmation, style: "padding: 5px; width: 250px;" %>
  </div>

  <div>
    <%= form.submit "Зберегти", style: "padding: 10px 20px; cursor: pointer;" %>
  </div>
<% end %>

<script>
  // Простий JS для перемикання полів залежно від вибраної ролі
  document.addEventListener("turbo:load", function() {
    const roleSelect = document.getElementById("role_select");
    const adminField = document.getElementById("admin_email_field");
    const staffField = document.getElementById("staff_username_field");

    function toggleFields() {
      if (roleSelect.value === "admin") {
        adminField.style.display = "block";
        staffField.style.display = "none";
      } else {
        adminField.style.display = "none";
        staffField.style.display = "flex";
      }
    }

    if (roleSelect) {
      roleSelect.addEventListener("change", toggleFields);
      toggleFields(); // Запускаємо при завантаженні
    }
  });
</script>