<div style="max-width: 600px; margin: 40px auto;">
  <%= form_with(model: @user, local: true) do |form| %>
    <% if @user.errors.any? %>
      <div style="background-color: #ffe5e5; border: 1px solid #e74c3c; color: #c0392b; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
        <h2 style="margin: 0 0 10px 0; font-size: 18px;"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
        <ul style="margin: 0; padding-left: 20px;">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 20px;">
      <%= form.label :email, style: "display: block; margin-bottom: 5px; font-weight: bold; color: #2c3e50;" %>
      <%= form.email_field :email, style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 14px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= form.label :password, style: "display: block; margin-bottom: 5px; font-weight: bold; color: #2c3e50;" %>
      <%= form.password_field :password, autocomplete: "new-password", style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 14px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= form.label :password_confirmation, style: "display: block; margin-bottom: 5px; font-weight: bold; color: #2c3e50;" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 14px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 30px;">
      <%= form.label :role, style: "display: block; margin-bottom: 5px; font-weight: bold; color: #2c3e50;" %>
      <%= form.select :role, options_for_select(['staff', 'manager', 'admin'], @user.role), {}, style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px; font-size: 14px; box-sizing: border-box;" %>
    </div>

    <div style="display: flex; gap: 10px;">
      <%= form.submit @user.new_record? ? "Create Staff Member" : "Update Staff Member", style: "padding: 12px 24px; background-color: #27ae60; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px;" %>
      <%= link_to "Cancel", users_path, style: "padding: 12px 24px; background-color: #95a5a6; color: white; text-decoration: none; border-radius: 4px; text-align: center;" %>
    </div>
  <% end %>
</div>
