<%= form_with(model: cinema, local: true, html: { class: 'container' }) do |form| %>
  <% if cinema.errors.any? %>
    <div id="error_explanation" class="error_explanation">
      <h2><%= pluralize(cinema.errors.count, "помилок") %> завадили зберегти кінотеатр:</h2>
      <ul>
        <% cinema.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="form-group">
      <%= form.label :name, 'Назва' %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="form-group">
      <%= form.label :address, 'Адреса' %>
      <%= form.text_field :address, required: true %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit 'Зберегти', class: 'btn btn-primary' %>
  </div>
<% end %>
