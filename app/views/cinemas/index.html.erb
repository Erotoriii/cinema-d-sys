<h1>Кінотеатри</h1>

<%= link_to "Додати новий кінотеатр", new_cinema_path, class: "btn btn-primary" %>

<% if @cinemas.any? %>
  <table>
    <thead>
      <tr>
        <th>Назва</th>
        <th>Адреса</th>
        <th>Компанія</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @cinemas.each do |cinema| %>
        <tr>
          <td><%= cinema.name %></td>
          <td><%= cinema.address %></td>
          <td><%= cinema.company&.name %></td>
          <td>
            <%= link_to "Переглянути", cinema_path(cinema) %>
            <%= link_to "Редагувати", edit_cinema_path(cinema) %>
            <%= link_to "Видалити", cinema_path(cinema), data: { turbo_method: :delete, turbo_confirm: "Ви впевнені?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Кінотеатрів не знайдено.</p>
<% end %>
