<h1><%= @cinema.name %></h1>

<div class="cinema-details">
  <p>
    <strong>Адреса:</strong>
    <%= @cinema.address %>
  </p>

  <p>
    <strong>Компанія:</strong>
    <%= @cinema.company&.name %>
  </p>

  <p>
    <strong>Створено:</strong>
    <%= @cinema.created_at.strftime("%B %d, %Y") %>
  </p>
</div>

<div class="actions">
  <%= link_to "Редагувати", edit_cinema_path(@cinema), class: "btn btn-secondary" %>
  <%= link_to "Видалити", cinema_path(@cinema), data: { turbo_method: :delete, turbo_confirm: "Ви впевнені?" }, class: "btn btn-danger" %>
  <%= link_to "Назад до кінотеатрів", cinemas_path, class: "btn btn-secondary" %>
</div>
