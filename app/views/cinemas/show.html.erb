<h1><%= @cinema.name %></h1>

<div class="cinema-details">
  <p>
    <strong>Address:</strong>
    <%= @cinema.address %>
  </p>

  <p>
    <strong>Company:</strong>
    <%= @cinema.company&.name %>
  </p>

  <p>
    <strong>Created at:</strong>
    <%= @cinema.created_at.strftime("%B %d, %Y") %>
  </p>
</div>

<div class="actions">
  <%= link_to "Edit", edit_cinema_path(@cinema), class: "btn btn-secondary" %>
  <%= link_to "Delete", cinema_path(@cinema), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %>
  <%= link_to "Back to Cinemas", cinemas_path, class: "btn btn-secondary" %>
</div>
