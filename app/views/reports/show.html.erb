<div class="report-page">
  <div class="report-topbar">
    <%= form_with model: @report, url: report_path(@report), method: :patch, local: true, class: "status-form" do |f| %>
      <div class="form-group">
        <%= f.label :status, "Статус" %>
        <%= f.select :status, Report.statuses.keys.map { |key| [Report::STATUS_LABELS[key], key] }, {}, { class: "status-select" } %>
      </div>
      <%= f.submit "Зберегти", class: "action-button" %>
    <% end %>

    <%= link_to "ЗАВАНТАЖИТИ", download_report_path(@report), class: "action-button secondary", data: { turbo: false } %>
  </div>

  <div class="report-card">
    <div class="report-section-header">Загальне</div>
    <div class="general-grid">
      <div><strong>Кінотеатр:</strong> <%= @report.cinema.name %></div>
      <div><strong>Адреса:</strong> <%= @report.cinema.address %></div>
      <div><strong>Працівник:</strong> <%= @report.user.name.present? ? @report.user.name : @report.user.email %></div>
      <div><strong>Початок зміни:</strong> <%= @report.start_time.strftime("%d/%m/%Y %H:%M") %></div>
      <div><strong>Кінець зміни:</strong> <%= @report.end_time.strftime("%d/%m/%Y %H:%M") %></div>
      <div><strong>Продано квитків:</strong> <%= @report.tickets_count || 0 %></div>
      <div><strong>Дохід:</strong> <%= number_to_currency(@report.total_revenue, unit: "₴", precision: 2) %></div>
    </div>
  </div>

  <div class="report-card">
    <div class="report-section-header">Продажі (товари)</div>
    <table class="products-report-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Продукт</th>
          <th>Кількість</th>
          <th>Дохід</th>
          <th>Продано</th>
          <th>Ціна за одиницю</th>
        </tr>
      </thead>
      <tbody>
        <% @report.products_rows.each_with_index do |row, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= row["name"] %></td>
            <td><%= row["amount"] %></td>
            <td><%= number_to_currency(row["income"], unit: "₴", precision: 2) %></td>
            <td><%= row["sold"] %></td>
            <td><%= number_to_currency(row["unit_price"], unit: "₴", precision: 2) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<style>
  .report-page {
    max-width: 960px;
    margin: 32px auto 48px;
    padding: 0 24px;
  }

  .report-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 20px;
  }

  .status-form {
    display: flex;
    align-items: flex-end;
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .status-select {
    min-width: 180px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid #d8e0ea;
  }

  .action-button {
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    background: #2563eb;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .action-button.secondary {
    background: #eef2f7;
    color: #1f2937;
    border: 1px solid #dbe2ea;
  }

  .report-card {
    background: #fff;
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    margin-bottom: 18px;
  }

  .report-section-header {
    background: #a3a3a3;
    color: #fff;
    text-align: center;
    font-weight: 700;
    margin: -20px -20px 16px;
    padding: 8px 12px;
    border-radius: 18px 18px 0 0;
  }

  .general-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
    color: #334155;
  }

  .products-report-table {
    width: 100%;
    border-collapse: collapse;
  }

  .products-report-table th,
  .products-report-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #edf1f5;
    text-align: left;
  }

  .products-report-table thead th {
    background: #f8fafc;
  }

  @media (max-width: 760px) {
    .report-topbar,
    .status-form {
      flex-direction: column;
      align-items: stretch;
    }

    .general-grid {
      grid-template-columns: 1fr;
    }
  }
</style>