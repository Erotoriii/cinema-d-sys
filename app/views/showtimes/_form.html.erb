<%= form_with(model: showtime, local: true) do |form| %>
  <% if showtime.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(showtime.errors.count, "error") %> prohibited this showtime from being saved:</h2>
      <ul>
        <% showtime.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :movie_id, "Фільм" %>
    <%= form.collection_select :movie_id, Movie.where(deleted_at: nil, company_id: current_user.company_id), :id, :title, { prompt: "Select a movie" }, { required: true } %>
  </div>

  <div class="field">
    <%= form.label :hall_id, "Зал" %>
    <%= form.collection_select :hall_id, Hall.where(cinema_id: current_user.company.cinema_ids), :id, :name, { prompt: "Select a hall" }, { required: true } %>
  </div>

  <div class="field">
    <%= form.label :start_time, "Час початку" %>
    <%= form.datetime_field :start_time, required: true %>
  </div>

  <div class="field" style="margin-bottom: 15px;">
    <%= form.label :price, "Ціна квитка (грн)" %><br>
    <%= form.number_field :price, required: true, min: 0, style: "padding: 5px; width: 150px;" %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>