<%= form_with(model: showtime, local: true) do |form| %>
  <% if showtime.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(showtime.errors.count, "error") %> prohibited this showtime from being saved:</h2>
      <ul>
        <% showtime.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :movie_id, "Фільм" %>
    <%= form.collection_select :movie_id, Movie.where(deleted_at: nil, company_id: current_user.company_id), :id, :title, { prompt: "Select a movie" }, { required: true } %>
  </div>

  <div class="field">
    <%= form.label :hall_id, "Зал" %>
    <%= form.collection_select :hall_id, Hall.where(cinema_id: current_user.company.cinema_ids), :id, :name, { prompt: "Select a hall" }, { required: true } %>
  </div>

  <div class="field">
    <%= form.label :start_time, "Час початку" %>
    <%= form.datetime_field :start_time, required: true %>
  </div>

  <div class="field" style="margin-top: 16px; padding: 16px; border: 1px solid #dbe4ef; border-radius: 14px; background: #f8fbff;">
    <h3 style="margin: 0 0 10px; font-size: 1rem; color: #0f172a;">Або створити кілька сеансів одразу</h3>
    <div class="field" style="margin-bottom: 12px;">
      <%= form.label :batch_date, "Дата для кількох сеансів" %><br>
      <%= form.date_field :batch_date, value: showtime.batch_date || Date.current %>
    </div>
    <div class="field">
      <%= form.label :batch_times_text, "Часи і ціни сеансів" %><br>
      <%= form.text_area :batch_times_text, rows: 5, placeholder: "10:00|120\n12:30|140\n15:45|160\n18:00", style: "width: 100%; max-width: 520px;" %>
      <div style="color: #64748b; font-size: 0.9rem; margin-top: 6px;">Формат: <strong>HH:MM|ціна</strong>. Ціну можна не вказувати, тоді візьметься базова ціна.</div>
    </div>
  </div>

  <div class="field" style="margin-bottom: 15px;">
    <%= form.label :price, "Ціна квитка (грн)" %><br>
    <%= form.number_field :price, required: true, min: 0, style: "padding: 5px; width: 150px;" %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>