<style>
  .dashboard-container {
    max-width: 600px;
    margin: 40px auto;
    padding: 30px;
    background: #f8f9fa;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .dashboard-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #2c3e50;
  }

  .shift-banner {
    padding: 20px;
    border-radius: 6px;
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .shift-banner.active {
    background-color: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
  }

  .shift-info {
    font-size: 16px;
    font-weight: 500;
  }

  .shift-time {
    font-size: 13px;
    color: #666;
    margin-top: 5px;
  }

  .form-group {
    margin-bottom: 15px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: #2c3e50;
  }

  .form-group select,
  .form-group input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
  }

  .form-group select:focus,
  .form-group input:focus {
    outline: none;
    border-color: #3498db;
    box-shadow: 0 0 5px rgba(52, 152, 219, 0.3);
  }

  .button-group {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }

  .btn {
    padding: 12px 20px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary {
    background-color: #3498db;
    color: white;
  }

  .btn-primary:hover {
    background-color: #2980b9;
  }

  .btn-danger {
    background-color: #e74c3c;
    color: white;
  }

  .btn-danger:hover {
    background-color: #c0392b;
  }

  .welcome-message {
    font-size: 16px;
    color: #555;
    margin-bottom: 30px;
  }
</style>

<div class="dashboard-container">
  <div class="dashboard-title">👤 Staff Dashboard</div>

  <div class="welcome-message">
    Hello, <strong><%= current_user.email %></strong>! Manage your shift below.
  </div>

  <% if current_workday.present? %>
    <!-- Active Shift Banner -->
    <div class="shift-banner active">
      <div>
        <div class="shift-info">✅ Active Shift at <strong><%= current_workday.cinema.name %></strong></div>
        <div class="shift-time">Started: <%= current_workday.start_time.strftime("%H:%M on %B %d, %Y") %></div>
      </div>
    </div>

    <!-- End Shift Button -->
    <div class="button-group">
      <%= link_to "End Shift", close_workday_path(current_workday), data: { turbo_method: :patch, turbo_confirm: "Are you sure you want to close the shift? This will generate the final report." }, class: "btn btn-danger" %>
    </div>
  <% else %>
    <!-- Start Shift Form -->
    <div class="welcome-message">
      You don't have an active shift. Start one below.
    </div>

    <%= form_with url: workdays_path, local: true, method: :post, scope: :workday do |f| %>
      <div class="form-group">
        <%= f.label :cinema_id, "Select Cinema" %>
        <%= f.collection_select :cinema_id, Cinema.where(company_id: current_user.company_id), :id, :name, { prompt: "Choose a cinema" } %>
      </div>

      <div class="button-group">
        <%= f.submit "Start Shift", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>

  <% if @forecasts_preview.present? %>
    <div style="margin-top:24px; background:#fff; padding:16px; border-radius:8px;">
      <h3 style="margin:0 0 8px 0;">Прогнози завантаженості (останні запуски)</h3>
      <table style="width:100%; border-collapse:collapse; margin-top:8px;">
        <thead>
          <tr>
            <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Hall</th>
            <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Showtime</th>
            <th style="text-align:right; padding:8px; border-bottom:1px solid #eee">Predicted</th>
            <th style="text-align:right; padding:8px; border-bottom:1px solid #eee">Fill %</th>
          </tr>
        </thead>
        <tbody>
          <% @forecasts_preview.each do |f| %>
            <tr>
              <td style="padding:8px; border-bottom:1px solid #f4f6f8"><%= f.hall.name %></td>
              <td style="padding:8px; border-bottom:1px solid #f4f6f8"><%= f.showtime_at.strftime("%d/%m %H:%M") %></td>
              <td style="padding:8px; text-align:right; border-bottom:1px solid #f4f6f8"><%= f.predicted_tickets.to_f.round(1) %></td>
              <td style="padding:8px; text-align:right; border-bottom:1px solid #f4f6f8"><%= f.predicted_fill_pct.to_f.round(1) %>%</td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div style="margin-top:8px; text-align:right">
        <%= link_to 'Переглянути всі прогнози', forecasts_path, class: 'btn btn-primary' %>
      </div>
    </div>
  <% end %>
</div>
