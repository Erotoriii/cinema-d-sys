<div style="max-width: 500px; margin: 40px auto; padding: 30px; background: white; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
  <h2 style="text-align: center; color: #2c3e50; margin-bottom: 30px;">Реєстрація Мережі Кінотеатрів</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <h4 style="color: #34495e; border-bottom: 1px solid #ecf0f1; padding-bottom: 10px; margin-bottom: 20px;">1. Дані Компанії</h4>

    <div style="margin-bottom: 15px;">
      <%= label_tag "company[name]", "Назва вашої мережі (напр. 'Планета Кіно')", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= text_field_tag "company[name]", params.dig(:company, :name), required: true, style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px;" %>
    </div>

    <div style="margin-bottom: 25px;">
      <%= label_tag "company[domain_prefix]", "Унікальний префікс (для корпоративної пошти)", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <div style="display: flex; align-items: center;">
        <%= text_field_tag "company[domain_prefix]", params.dig(:company, :domain_prefix), required: true, placeholder: "напр. planeta", style: "flex: 1; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px 0 0 4px;" %>
        <span style="background: #ecf0f1; padding: 10px 15px; border: 1px solid #bdc3c7; border-left: none; border-radius: 0 4px 4px 0; color: #7f8c8d;">.ua</span>
      </div>
      <small style="color: #7f8c8d; display: block; margin-top: 5px;">Тільки латинські літери та цифри. Персонал матиме логіни формату логін@префікс.ua</small>
    </div>

    <h4 style="color: #34495e; border-bottom: 1px solid #ecf0f1; padding-bottom: 10px; margin-bottom: 20px;">2. Профіль Власника</h4>

    <div style="margin-bottom: 15px;">
      <%= f.label :email, "Ваш особистий Email", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "Пароль", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <% if @minimum_password_length %>
        <small style="color: #7f8c8d;">(мінімум <%= @minimum_password_length %> символів)</small>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px;" %>
    </div>

    <div style="margin-bottom: 25px;">
      <%= f.label :password_confirmation, "Підтвердження пароля", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, style: "width: 100%; padding: 10px; border: 1px solid #bdc3c7; border-radius: 4px;" %>
    </div>

    <div style="text-align: center;">
      <%= f.submit "Зареєструвати Бізнес", style: "background-color: #27ae60; color: white; border: none; padding: 15px 30px; font-size: 1.1rem; font-weight: bold; border-radius: 4px; cursor: pointer; width: 100%;" %>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 20px;">
    <%= render "devise/shared/links" %>
  </div>
</div>