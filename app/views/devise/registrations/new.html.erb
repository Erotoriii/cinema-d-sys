<style>
  .registration-shell {
    max-width: 1120px;
    margin: 26px auto;
    padding: 0 16px;
  }

  .registration-layout {
    max-width: 560px;
    margin: 0 auto;
  }

  .registration-card {
    background: #fff;
    border-radius: 24px;
    border: 1px solid #e5eaf3;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
    padding: 26px;
  }

  .registration-card h2 {
    margin: 0 0 18px;
    color: #0f172a;
  }

  .registration-section {
    margin-top: 20px;
    margin-bottom: 16px;
    font-size: 0.94rem;
    color: #334155;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .registration-field {
    margin-bottom: 14px;
  }

  .registration-field label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    color: #334155;
  }

  .registration-field input[type="text"],
  .registration-field input[type="email"],
  .registration-field input[type="password"] {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid #d7deea;
    border-radius: 12px;
    font-size: 0.95rem;
    box-sizing: border-box;
  }

  .registration-field input:focus {
    border-color: #2563eb;
    outline: none;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14);
  }

  .registration-hint {
    margin-top: 6px;
    font-size: 0.84rem;
    color: #64748b;
    line-height: 1.35;
  }

  .registration-submit {
    width: 100%;
    padding: 12px 16px;
    border: none;
    border-radius: 999px;
    background: #16a34a;
    color: #fff;
    font-size: 0.98rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 6px;
  }

  .registration-submit:hover {
    background: #15803d;
  }

  .registration-links {
    margin-top: 14px;
    color: #475569;
  }

  .registration-links p {
    margin: 7px 0;
  }

</style>

<div class="registration-shell">
  <section class="registration-layout">
    <article class="registration-card">
      <h2>Реєстрація бізнесу</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="registration-section">1. Дані компанії</div>

        <div class="registration-field">
          <%= label_tag "company[name]", "Назва мережі (наприклад: Планета Кіно)" %>
          <%= text_field_tag "company[name]", params.dig(:company, :name), required: true %>
        </div>

        <div class="registration-field">
          <%= label_tag "company[domain_prefix]", "Домен компанії для корпоративних email" %>
          <%= text_field_tag "company[domain_prefix]", params.dig(:company, :domain_prefix), required: true, placeholder: "cinema.com" %>
          <div class="registration-hint">Вкажіть повний домен. Логіни співробітників формуються як логін@домен.</div>
        </div>

        <div class="registration-section">2. Профіль власника</div>

        <div class="registration-field">
          <%= f.label :email, "Ваш особистий email" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
        </div>

        <div class="registration-field">
          <%= f.label :password, "Пароль" %>
          <% if @minimum_password_length %>
            <div class="registration-hint">Мінімум <%= @minimum_password_length %> символів.</div>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", required: true %>
        </div>

        <div class="registration-field">
          <%= f.label :password_confirmation, "Підтвердження пароля" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
        </div>

        <%= f.submit "Зареєструвати бізнес", class: "registration-submit" %>
      <% end %>

      <div class="registration-links">
        <%= render "devise/shared/links" %>
      </div>
    </article>
  </section>
</div>