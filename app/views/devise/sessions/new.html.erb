<style>
  .auth-shell {
    max-width: 1180px;
    margin: 26px auto;
    padding: 0 16px;
  }

  .auth-layout {
    max-width: 520px;
    margin: 0 auto;
  }

  .auth-card {
    background: #fff;
    border-radius: 24px;
    border: 1px solid #e5eaf3;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
    padding: 26px;
  }

  .auth-card h2 {
    margin: 0 0 18px;
    color: #0f172a;
  }

  .auth-field {
    margin-bottom: 14px;
  }

  .auth-field label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    color: #334155;
  }

  .auth-field input[type="email"],
  .auth-field input[type="password"] {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid #d7deea;
    border-radius: 12px;
    font-size: 0.95rem;
  }

  .auth-field input:focus {
    border-color: #2563eb;
    outline: none;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.14);
  }

  .auth-remember {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: #334155;
    font-size: 0.92rem;
  }

  .auth-submit {
    width: 100%;
    padding: 12px 16px;
    border: none;
    border-radius: 999px;
    background: #2563eb;
    color: #fff;
    font-size: 0.98rem;
    font-weight: 700;
    cursor: pointer;
  }

  .auth-submit:hover {
    background: #1d4ed8;
  }

  .auth-links {
    margin-top: 14px;
    color: #475569;
  }

  .auth-links p {
    margin: 7px 0;
  }

</style>

<div class="auth-shell">
  <section class="auth-layout">
    <article class="auth-card">
      <h2>Увійти</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="auth-field">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
        </div>

        <div class="auth-field">
          <%= f.label :password, "Пароль" %>
          <%= f.password_field :password, autocomplete: "current-password" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="auth-remember">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, "Запам'ятати мене" %>
          </div>
        <% end %>

        <%= f.submit "Увійти", class: "auth-submit" %>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </article>
  </section>
</div>
