<style>
  .hall-container {
    max-width: 800px;
    margin: 40px auto;
    padding: 20px;
  }

  .hall-details {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid #ddd;
  }

  .cinema-map {
    text-align: center;
    background-color: #f9f9f9;
    padding: 30px;
    border-radius: 8px;
    margin: 30px 0;
  }

  .screen {
    width: 100%;
    height: 40px;
    background: linear-gradient(90deg, #333 0%, #555 50%, #333 100%);
    border-radius: 50% 50% 0 0;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 14px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  .seating-chart {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  .row-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    width: 100%;
  }

  .row-label {
    font-weight: bold;
    min-width: 56px;
    text-align: center;
    font-size: 14px;
    color: #333;
  }

  .row-seats {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 100%;
  }

  .seat {
    width: 30px;
    height: 30px;
    border: 2px solid #ccc;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .seat.available {
    background-color: #4CAF50;
    color: white;
    border-color: #45a049;
  }

  .seat.available:hover {
    background-color: #45a049;
    transform: scale(1.1);
  }

  .seat.reserved {
    background-color: #f44336;
    color: white;
    border-color: #da190b;
    cursor: not-allowed;
  }

  .seat.sold {
    background-color: #999;
    color: white;
    border-color: #666;
    cursor: not-allowed;
  }

  .legend {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #ddd;
    font-size: 13px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend-seat {
    width: 20px;
    height: 20px;
    border: 2px solid #ccc;
    border-radius: 3px;
  }

  .actions {
    margin-top: 30px;
    text-align: center;
  }
</style>

<div class="hall-container">
  <h1><%= @hall.name %></h1>

  <div class="hall-details">
    <p>
      <strong>Кінотеатр:</strong>
      <%= link_to @hall.cinema&.name, cinema_path(@hall.cinema) if @hall.cinema %>
    </p>

    <p>
      <strong>Конфігурація:</strong>
      <%= @hall.rows %> ряд(и) × <%= @hall.seats_per_row %> місць в ряду
    </p>

    <p>
      <strong>Всього місць:</strong>
      <%= @hall.seats.count %>
    </p>

    <p>
      <strong>Створено:</strong>
      <%= @hall.created_at.strftime("%B %d, %Y") %>
    </p>
  </div>

  <div class="cinema-map">
  <div class="screen">ЕКРАН</div>

    <div class="seating-chart">
      <% @hall.seats.group_by(&:row).sort.each do |row_num, seats| %>
        <div class="row-container">
          <div class="row-label">Ряд <%= row_num %></div>
          <div class="row-seats">
            <% seats.sort_by(&:number).each do |seat| %>
              <div class="seat <%= seat.status %>" title="Ряд <%= seat.row %>, Місце <%= seat.number %>">
                <%= seat.number %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="legend">
      <div class="legend-item">
        <div class="legend-seat" style="background-color: #4CAF50; border-color: #45a049;"></div>
        <span>Доступно</span>
      </div>
      <div class="legend-item">
        <div class="legend-seat" style="background-color: #f44336; border-color: #da190b;"></div>
        <span>Зарезервовано</span>
      </div>
      <div class="legend-item">
        <div class="legend-seat" style="background-color: #999; border-color: #666;"></div>
        <span>Продано</span>
      </div>
    </div>
  </div>

  <div class="hall-details" style="border-bottom: none;">
    <h2 style="margin-bottom: 16px;">Розклад у цьому залі</h2>

    <% if @hall.showtimes.includes(:movie).any? %>
      <table style="width:100%; border-collapse: collapse; background: #fff;">
        <thead>
          <tr>
            <th style="text-align:left; padding: 10px; border-bottom: 1px solid #ddd;">Фільм</th>
            <th style="text-align:left; padding: 10px; border-bottom: 1px solid #ddd;">Дата і час</th>
            <th style="text-align:left; padding: 10px; border-bottom: 1px solid #ddd;">Ціна</th>
          </tr>
        </thead>
        <tbody>
          <% @hall.showtimes.includes(:movie).order(:start_time).each do |showtime| %>
            <tr>
              <td style="padding: 10px; border-bottom: 1px solid #f0f0f0;"><%= showtime.movie&.title %></td>
              <td style="padding: 10px; border-bottom: 1px solid #f0f0f0;"><%= showtime.start_time.strftime("%d/%m/%Y %H:%M") %></td>
              <td style="padding: 10px; border-bottom: 1px solid #f0f0f0;"><%= number_to_currency(showtime.price, unit: "₴", precision: 2) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p style="color: #666; margin: 0;">У цьому залі ще немає запланованих сеансів.</p>
    <% end %>
  </div>

  <div class="actions">
    <%= link_to "Редагувати", edit_hall_path(@hall), class: "btn btn-secondary" %>
    <%= link_to "Видалити", hall_path(@hall), data: { turbo_method: :delete, turbo_confirm: "Ви впевнені?" }, class: "btn btn-danger" %>
    <%= link_to "Назад до залів", halls_path, class: "btn btn-secondary" %>
  </div>
</div>
