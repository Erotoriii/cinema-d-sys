<h1>Зали</h1>

<%= link_to "Додати новий зал", new_hall_path, class: "btn btn-primary" %>

<% if @halls.any? %>
  <table>
    <thead>
      <tr>
        <th>Назва</th>
        <th>Кінотеатр</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @halls.each do |hall| %>
        <tr>
          <td><%= hall.name %></td>
          <td><%= hall.cinema&.name %></td>
          <td>
            <%= link_to "Переглянути", hall_path(hall) %>
            <%= link_to "Редагувати", edit_hall_path(hall) %>
            <%= link_to "Видалити", hall_path(hall), data: { turbo_method: :delete, turbo_confirm: "Ви впевнені?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Залів не знайдено.</p>
<% end %>
