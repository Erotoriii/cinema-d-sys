<div class="forecasts-page">
  <h1>Forecast Runs</h1>

  <% if @runs.any? %>
    <table style="width:100%; border-collapse:collapse; margin-top:12px;">
      <thead>
        <tr>
          <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Run</th>
          <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Run at</th>
          <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Horizon (days)</th>
          <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Model</th>
          <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Forecasts</th>
          <th style="text-align:right; padding:8px; border-bottom:1px solid #eee"></th>
        </tr>
      </thead>
      <tbody>
        <% @runs.each do |run| %>
          <tr>
            <td style="padding:8px; border-bottom:1px solid #f6f8fa">#<%= run.id %></td>
            <td style="padding:8px; border-bottom:1px solid #f6f8fa"><%= run.run_at.strftime("%d/%m/%Y %H:%M") %></td>
            <td style="padding:8px; border-bottom:1px solid #f6f8fa"><%= run.horizon_days %></td>
            <td style="padding:8px; border-bottom:1px solid #f6f8fa"><%= run.model %></td>
            <td style="padding:8px; border-bottom:1px solid #f6f8fa"><%= run.forecasts.count %></td>
            <td style="padding:8px; text-align:right; border-bottom:1px solid #f6f8fa"><%= link_to 'View', forecast_path(run), class: 'btn btn-primary' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No forecast runs yet. Run <code>ForecastRunnerJob</code> to generate forecasts.</p>
  <% end %>
</div>
