<% latest_run = @runs.first %>
<% latest_forecasts = defined?(@latest_forecasts) ? @latest_forecasts : (latest_run ? latest_run.forecasts.includes(:hall, :movie, showtime: :movie).sort_by(&:showtime_at) : []) %>
<% forecasts_by_date = defined?(@forecasts_by_date) ? @forecasts_by_date : latest_forecasts.group_by { |forecast| forecast.showtime_at.to_date } %>

<style>
  .forecast-dashboard {
    max-width: 100%;
    margin: 0;
    padding: 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #111827;
  }

  .forecast-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 0;
    margin-bottom: 18px;
    border-bottom: 1px solid #e5e7eb;
  }

  .forecast-header h1 {
    margin: 0 0 6px 0;
    font-size: 1.75rem;
    color: #1f2937;
  }

  .forecast-header p {
    margin: 0;
    font-size: 0.95rem;
    color: #6b7280;
  }

  .forecast-toolbar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
  }

  .forecast-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }

  .summary-card {
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff 0%, #f9fafb 100%);
    padding: 16px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  .summary-label {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 8px;
  }

  .summary-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.1;
  }

  .summary-note {
    margin-top: 8px;
    color: #6b7280;
    font-size: 0.85rem;
  }

  .date-group {
    margin-bottom: 18px;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
  }

  .date-group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(90deg, #111827 0%, #1f2937 100%);
    color: #fff;
  }

  .date-group-header .date-title {
    font-size: 1rem;
    font-weight: 800;
  }

  .date-group-header .date-meta {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .forecast-table {
    width: 100%;
    border-collapse: collapse;
  }

  .forecast-table th,
  .forecast-table td {
    padding: 12px 14px;
    border-bottom: 1px solid #eef2f7;
    vertical-align: middle;
  }

  .forecast-table th {
    background: #f9fafb;
    text-align: left;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  .forecast-table tbody tr:hover {
    background: #f9fafb;
  }

  .slot-time {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .slot-time strong {
    font-weight: 700;
    color: #111827;
  }

  .slot-time span {
    font-size: 0.82rem;
    color: #6b7280;
  }

  .hall-pill {
    display: inline-block;
    padding: 4px 10px;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 999px;
  }

  .movie-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: #1f2937;
    line-height: 1.35;
  }

  .cinema-name {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .prediction-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 76px;
    padding: 6px 10px;
    border-radius: 999px;
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
  }

  .occupancy-bar {
    height: 8px;
    width: 100%;
    border-radius: 999px;
    background: #e5e7eb;
    overflow: hidden;
  }

  .occupancy-bar-fill {
    height: 100%;
    border-radius: inherit;
  }

  .occupancy-text {
    font-size: 0.85rem;
    color: #4b5563;
    text-align: right;
  }

  .run-note {
    font-size: 0.82rem;
    color: #6b7280;
    text-align: right;
  }

  .date-footer {
    display: flex;
    justify-content: space-between;
    color: #6b7280;
    font-size: 0.83rem;
  }

  .last-update {
    font-size: 0.78rem;
    color: #9ca3af;
  }

  .empty-state {
    padding: 36px 16px;
    text-align: center;
    color: #6b7280;
    background: #f9fafb;
    border-radius: 14px;
    border: 1px dashed #d1d5db;
  }

  @media (max-width: 768px) {
    .forecast-header,
    .date-group-header,
    .date-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .forecast-summary {
      grid-template-columns: 1fr 1fr;
    }

    .forecast-table {
      display: block;
      overflow-x: auto;
    }
  }
</style>

<div class="forecast-dashboard">
  <div class="forecast-header">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h1>Прогноз завантаженості (7 днів)</h1>
        <p>Таблиця прогнозів, згрупована по датах показу</p>
      </div>
      <div class="forecast-toolbar">
        <%= button_to "🔄 Оновити прогнози (Ручний запуск)", run_forecasts_path, method: :post, class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm transition duration-200" %>
        <% if latest_run %>
          <div class="run-note">Останній запуск: <%= latest_run.run_at.strftime("%d/%m %H:%M") %></div>
        <% end %>
      </div>
    </div>
  </div>

  <% if latest_run && latest_forecasts.any? %>
    <div class="forecast-summary">
      <div class="summary-card">
        <div class="summary-label">Усього прогнозів</div>
        <div class="summary-value"><%= latest_forecasts.size %></div>
        <div class="summary-note">Сеансів у останньому запуску</div>
      </div>
      <div class="summary-card">
        <div class="summary-label">Прогноз квитків</div>
        <div class="summary-value"><%= @total_predicted_tickets.to_f.round(0).to_i %></div>
        <div class="summary-note">Сумарно на всі сеанси</div>
      </div>
      <div class="summary-card">
        <div class="summary-label">Середня заповненість</div>
        <div class="summary-value"><%= @average_occupancy.to_f.round(1) %>%</div>
        <div class="summary-note">По останньому запуску</div>
      </div>
      <div class="summary-card">
        <div class="summary-label">Очікувана виручка</div>
        <div class="summary-value"><%= number_to_currency(@expected_revenue.to_f, unit: "₴", precision: 0) %></div>
        <div class="summary-note">Оцінка за цінами showtime</div>
      </div>
      <% if @global_mape.present? && (current_user.admin? || current_user.manager?) %>
        <div class="summary-card">
          <div class="summary-label">MAPE</div>
          <div class="summary-value"><%= @global_mape.round(1) %>%</div>
          <div class="summary-note">Точність прогнозу</div>
        </div>
      <% end %>
    </div>

    <% forecasts_by_date.sort_by { |date, _| date }.each do |date, forecasts| %>
      <% date_forecasts = forecasts.sort_by(&:showtime_at) %>
      <% date_total = date_forecasts.sum { |forecast| forecast.predicted_tickets.to_f } %>
      <% date_avg = date_forecasts.any? ? (date_forecasts.sum { |forecast| forecast_occupancy_pct(forecast) } / date_forecasts.size) : 0.0 %>

      <section class="date-group">
        <div class="date-group-header">
          <div>
            <div class="date-title"><%= date.strftime("%A, %d %B %Y") %></div>
            <div class="date-meta"><%= date_forecasts.size %> сеансів</div>
          </div>
          <div class="date-meta">
            <div>Разом: <strong><%= date_total.round(0).to_i %></strong> квитків</div>
            <div>Середня заповненість: <strong><%= date_avg.round(1) %>%</strong></div>
          </div>
        </div>

        <table class="forecast-table">
          <thead>
            <tr>
              <th>Час</th>
              <th>Фільм</th>
              <th>Зал</th>
              <th style="text-align:right;">Прогноз</th>
              <th style="width: 22%;">Заповненість</th>
              <th style="text-align:right;">Ціна</th>
            </tr>
          </thead>
          <tbody>
            <% date_forecasts.each do |forecast| %>
              <% occupancy = forecast_occupancy_pct(forecast) %>
              <% bar_color = forecast_occupancy_color(occupancy) %>
              <% title = forecast_movie_title(forecast) %>
              <% exact_showtime = forecast_showtime_for(forecast) %>
              <% time_label = forecast.showtime_at.strftime("%H:%M") %>
              <% if exact_showtime && exact_showtime.movie&.duration.present? %>
                <% ends_at = exact_showtime.start_time + exact_showtime.movie.duration.minutes %>
                <% time_label = "#{exact_showtime.start_time.strftime('%H:%M')} - #{ends_at.strftime('%H:%M')}" %>
              <% end %>

              <tr>
                <td>
                  <div class="slot-time">
                    <strong><%= time_label %></strong>
                    <span><%= forecast.showtime_at.strftime("%d/%m") %></span>
                  </div>
                </td>
                <td>
                  <div class="movie-title"><%= title %></div>
                  <div class="cinema-name"><%= forecast.hall&.cinema&.name || "Кінотеатр" %></div>
                </td>
                <td><span class="hall-pill"><%= forecast.hall&.name || "Зал" %></span></td>
                <td style="text-align:right;">
                  <div style="font-weight: 800; font-size: 1rem;"><%= forecast.predicted_tickets.to_f.round(0).to_i %></div>
                  <div style="font-size: 0.8rem; color: #6b7280;">квитків</div>
                </td>
                <td>
                  <div class="occupancy-bar">
                    <div class="occupancy-bar-fill" style="width: <%= [occupancy, 100].min %>%; background: <%= bar_color %>;"></div>
                  </div>
                  <div class="occupancy-text"><%= occupancy.round(0).to_i %>% залу</div>
                </td>
                <td style="text-align:right;">
                  <span class="prediction-badge" style="background: <%= bar_color %>;"><%= number_to_currency(forecast.showtime&.price.to_f, unit: "₴", precision: 0) %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="date-footer" style="padding: 12px 16px; border-top: 1px solid #eef2f7;">
          <div>Оновлено: <%= latest_run.run_at.strftime("%d/%m %H:%M") %></div>
          <div><%= date_forecasts.size %> рядків у таблиці</div>
        </div>
      </section>
      <% end %>

  <% else %>
    <div class="empty-state">
      <strong>Прогнози ще не згенеровані</strong>
      <div>Запустіть ForecastRunnerJob</div>
    </div>
  <% end %>
</div>
