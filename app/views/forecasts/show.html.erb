<div class="forecast-run-page">
  <h1>Запуск прогнозу #<%= @run.id %></h1>
  <p>Запущено: <%= @run.run_at.strftime("%d/%m/%Y %H:%M") %> — горизонт: <%= @run.horizon_days %> днів — модель: <%= @run.model %></p>

  <% if @forecasts.any? %>
    <table style="width:100%; border-collapse:collapse; margin-top:12px;">
      <thead>
        <tr>
          <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Зал</th>
          <th style="text-align:left; padding:8px; border-bottom:1px solid #eee">Сеанс</th>
          <th style="text-align:right; padding:8px; border-bottom:1px solid #eee">Прогноз (квитки)</th>
          <th style="text-align:right; padding:8px; border-bottom:1px solid #eee">Заповненість %</th>
        </tr>
      </thead>
      <tbody>
        <% @forecasts.each do |f| %>
          <tr>
            <td style="padding:8px; border-bottom:1px solid #f6f8fa"><%= f.hall&.name %></td>
            <td style="padding:8px; border-bottom:1px solid #f6f8fa"><%= f.showtime_at.strftime("%d/%m %H:%M") %></td>
            <td style="padding:8px; text-align:right; border-bottom:1px solid #f6f8fa"><%= f.predicted_tickets.to_f.round(1) %></td>
            <td style="padding:8px; text-align:right; border-bottom:1px solid #f6f8fa"><%= f.predicted_fill_pct.to_f.round(1) %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Немає прогнозів у цьому запуску.</p>
  <% end %>

  <div style="margin-top:12px">
    <%= link_to 'Назад', forecasts_path, class: 'btn' %>
  </div>
</div>
