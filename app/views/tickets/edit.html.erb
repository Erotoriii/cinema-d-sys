<%= form_with model: @ticket, local: true, data: { turbo: false } do |form| %>
  <% if @ticket.errors.any? %>
    <div id="error_explanation" class="error-box">
      <h2><%= pluralize(@ticket.errors.count, "error") %> prohibited this ticket from being saved:</h2>
      <ul>
        <% @ticket.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :seat_id, "Seat" %>
    <%= form.select :seat_id, @available_seats.map { |s| ["Row #{s.row}, Seat #{s.number}", s.id] }, { prompt: 'Select seat' }, { required: true } %>
  </div>

  <div class="field">
    <%= form.label :status %>
    <%= form.select :status, [['Sold', 'sold'], ['Pending', 'pending'], ['Available', 'cancelled']], { prompt: 'Select status' }, { required: true } %>
  </div>

  <div class="actions">
    <%= form.submit "Update Ticket", class: "btn btn-primary", onclick: "submitTicketForm(event, #{@ticket.id})" %>
    <button type="button" onclick="closeEditModal()" class="btn btn-secondary">Cancel</button>
  </div>
<% end %>

<script>
  function submitTicketForm(event, ticketId) {
    event.preventDefault();
    
    const form = event.target.form;
    const formData = new FormData(form);
    
    fetch(`/tickets/${ticketId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({
        ticket: {
          seat_id: formData.get('ticket[seat_id]'),
          status: formData.get('ticket[status]')
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        closeEditModal();
        alert(data.message);
        location.reload();
      } else {
        alert('Error: ' + data.errors.join(', '));
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error updating ticket');
    });
  }
</script>

<style>
  .field {
    margin-bottom: 1.5rem;
  }

  .field label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: #333;
  }

  .field select,
  .field input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    box-sizing: border-box;
  }

  .field select:focus,
  .field input:focus {
    outline: none;
    border-color: #2196F3;
    box-shadow: 0 0 0 2px rgba(33, 150, 243, 0.1);
  }

  .error-box {
    background-color: #ffebee;
    border: 1px solid #f44336;
    border-radius: 4px;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .error-box h2 {
    color: #f44336;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .error-box ul {
    list-style: none;
    padding: 0;
  }

  .error-box li {
    color: #f44336;
    margin: 0.25rem 0;
  }

  .actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn {
    flex: 1;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-primary {
    background-color: #2196F3;
    color: white;
  }

  .btn-primary:hover {
    background-color: #0b7dda;
  }

  .btn-secondary {
    background-color: #6c757d;
    color: white;
  }

  .btn-secondary:hover {
    background-color: #5a6268;
  }
</style>
