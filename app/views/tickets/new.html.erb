<style>
  .tickets-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .booking-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #ddd;
  }

  .booking-header h1 {
    margin: 0 0 1rem 0;
    font-size: 2rem;
    color: #333;
  }

  .movie-info {
    margin-top: 1rem;
  }

  .movie-info h2 {
    margin: 0.5rem 0;
    font-size: 1.5rem;
    color: #555;
  }

  .movie-info p {
    margin: 0.25rem 0;
    font-size: 1rem;
    color: #777;
  }

  .ticket-price {
    font-weight: 600;
    color: #333;
  }

  .screen-container {
    text-align: center;
    margin: 2rem 0;
  }

  .screen {
    display: inline-block;
    background: linear-gradient(to bottom, #ccc, #999);
    color: #333;
    padding: 1rem 4rem;
    font-size: 1.2rem;
    font-weight: bold;
    letter-spacing: 2px;
    border-radius: 8px 8px 0 0;
    width: 80%;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .seat-map {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .seat-grid {
    display: grid;
    padding: 2rem;
    background: #f5f5f5;
    border-radius: 4px;
  }

  .seat-label {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 2px solid #ddd;
    border-radius: 4px;
    font-weight: bold;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    background-color: #4caf50;
    color: white;
    border-color: #45a049;
  }

  .seat-label:hover:not(.seat-sold) {
    background-color: #45a049;
    transform: scale(1.1);
  }

  .seat-label:active:not(.seat-sold) {
    transform: scale(0.95);
  }

  .seat-label input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .seat-label.seat-selected .seat-text,
  .seat-label input[type="checkbox"]:checked + .seat-text {
    background-color: #2196F3;
    border-color: #0b7dda;
  }

  .seat-label.seat-status-sold {
    background-color: #f44336;
    color: white;
    border-color: #da190b;
    cursor: pointer;
    opacity: 0.7;
  }

  .seat-label.seat-status-sold:hover {
    background-color: #f44336;
    opacity: 1;
    transform: none;
  }

  .seat-label.seat-status-pending {
    background-color: #ff9800;
    color: white;
    border-color: #e65100;
    cursor: pointer;
    opacity: 0.7;
  }

  .seat-label.seat-status-pending:hover {
    background-color: #ff9800;
    opacity: 1;
    transform: none;
  }

  .seat-label.seat-sold {
    background-color: #f44336;
    color: white;
    border-color: #da190b;
    cursor: pointer;
    opacity: 0.7;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seat-label.seat-sold:hover {
    background-color: #f44336;
    transform: none;
    opacity: 1;
  }

  a.seat-label.seat-sold {
    color: white;
    text-decoration: none;
  }

  a.seat-label.seat-sold:visited {
    color: white;
  }

  .seat-text {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: inherit;
    border-radius: 2px;
    transition: background-color 0.2s ease;
  }

  .legend {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin: 2rem 0;
    padding: 1rem;
    background: #f9f9f9;
    border-radius: 4px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-box {
    width: 30px;
    height: 30px;
    border: 2px solid #ddd;
    border-radius: 4px;
  }

  .legend-box.available {
    background-color: #4caf50;
    border-color: #45a049;
  }

  .legend-box.selected {
    background-color: #2196F3;
    border-color: #0b7dda;
  }

  .legend-box.sold {
    background-color: #f44336;
    border-color: #da190b;
  }

  .legend-item span {
    font-weight: 500;
    color: #555;
  }

  .actions {
    text-align: center;
    margin-top: 2rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
    margin: 0 0.5rem;
  }

  .btn-primary {
    background-color: #2196F3;
    color: white;
  }

  .btn-primary:hover {
    background-color: #0b7dda;
  }

  .btn-secondary {
    background-color: #6c757d;
    color: white;
  }

  .btn-secondary:hover {
    background-color: #5a6268;
  }

  .ticket-form {
    display: contents;
  }

  .stats-panel {
    display: flex;
    flex-direction: column;
    background-color: #e3f2fd;
    padding: 2rem;
    border-radius: 8px;
    gap: 1.5rem;
  }

  .stat-item {
    text-align: center;
    flex: 1;
  }

  .stat-value {
    font-size: 1.8rem;
    font-weight: bold;
    color: #1976d2;
  }

  .stat-label {
    text-transform: uppercase;
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.5rem;
    letter-spacing: 1px;
  }
</style>

<div class="tickets-container">
  <div style="display: flex; gap: 2rem;">
    <div style="flex: 1;">
      <div class="booking-header">
        <h1>Продаж квитків</h1>
        <div class="movie-info">
          <h2><%= @movie.title %></h2>
          <p class="ticket-price"><strong>Ціна:</strong> <%= @showtime.price %> UAH</p>
          <p><strong>Дата та час:</strong> <%= @showtime.start_time.strftime("%B %d, %Y at %H:%M") %></p>
          <p><strong>Кінотеатр:</strong> <%= @hall.cinema.name %></p>
          <p><strong>Зал:</strong> <%= @hall.name %></p>
        </div>
      </div>

      <div class="screen-container">
        <div class="screen">ЕКРАН</div>
      </div>

      <%= form_with url: tickets_path, method: :post, local: true, class: "ticket-form" do |form| %>
    <!-- Hidden field for showtime_id - MUST be nested under 'ticket' -->
    <%= hidden_field_tag "ticket[showtime_id]", @showtime.id %>

    <div class="seat-map">
      <div class="seat-grid" style="grid-template-columns: repeat(<%= @hall.seats_per_row %>, 1fr); gap: 8px;">
        <% @seats.each do |seat| %>
          <% ticket = @tickets_by_seat[seat.id] %>
          <% if ticket && ticket.status != 'cancelled' %>
            <button type="button" class="seat-label seat-status-<%= ticket.status %>" data-seat-id="<%= seat.id %>" data-ticket-id="<%= ticket.id %>" title="Правий клік — опції: Місце <%= seat.row %>-<%= seat.number %> (<%= ticket.status %>)">
              <div class="seat-text"><%= seat.number %></div>
            </button>
          <% else %>
            <label class="seat-label" title="Місце <%= seat.row %>-<%= seat.number %>">
              <%= check_box_tag "ticket[seat_ids][]", seat.id %>
              <div class="seat-text"><%= seat.number %></div>
            </label>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="legend">
      <div class="legend-item">
        <div class="legend-box available"></div>
        <span>Доступно</span>
      </div>
      <div class="legend-item">
        <div class="legend-box selected"></div>
        <span>Вибрано</span>
      </div>
      <div class="legend-item">
        <div class="legend-box sold"></div>
        <span>Продано</span>
      </div>
      <div class="legend-item">
        <div class="legend-box" style="background-color: #ff9800; border-color: #e65100;"></div>
        <span>У обробці</span>
      </div>
    </div>

    <div class="actions">
      <p id="total-price-display" style="margin-bottom: 1rem; font-size: 1.1rem; font-weight: 600;">Загальна сума: 0 UAH</p>
      <%= form.submit "Продати вибрані квитки", class: "btn btn-primary" %>
      <%= link_to "Назад до сеансів", showtimes_path, class: "btn btn-secondary" %>
    </div>
      <% end %>
    </div>

    <div style="flex: 0 0 320px; display: flex; flex-direction: column; justify-content: center;">
      <% sold_tickets_count = @showtime.tickets.where(status: ['Sold', 'sold']).count %>
      <% unavailable_tickets_count = @showtime.tickets.where.not(status: ['Available', 'available', 'cancelled', nil]).count %>
      <% available_seats_count = @seats.count - unavailable_tickets_count %>
      <% total_earned = sold_tickets_count * (@showtime.price || 0) %>

      <div class="stats-panel">
        <div class="stat-item">
          <div class="stat-value"><%= available_seats_count %></div>
          <div class="stat-label">Доступні місця</div>
        </div>
        <div class="stat-item">
          <div class="stat-value"><%= sold_tickets_count %></div>
          <div class="stat-label">Продані місця</div>
        </div>
        <div class="stat-item">
          <div class="stat-value"><%= total_earned %> UAH</div>
          <div class="stat-label">Загальний дохід</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Seat Right-Click Context Menu -->
<div id="seat-context-menu" class="context-menu" style="display: none; position: fixed; z-index: 1000;">
  <div class="context-menu-item" data-action="cancelled">Скасувати місце</div>
  <div class="context-menu-item" data-action="sold">Позначити як продане</div>
  <div class="context-menu-item" data-action="pending">Позначити як в обробці</div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const seatCheckboxes = document.querySelectorAll('input[name="ticket[seat_ids][]"]');
    const totalPriceDisplay = document.getElementById('total-price-display');
    const ticketPrice = <%= @showtime.price.to_f %>;
    const contextMenu = document.getElementById('seat-context-menu');
    let currentSeatId = null;
    let currentTicketId = null;

    function updateTotalPrice() {
      const selectedCount = document.querySelectorAll('.seat-selected').length;
      if (totalPriceDisplay) {
        totalPriceDisplay.innerText = `Загальна сума: ${selectedCount * ticketPrice} UAH`;
      }
    }

    seatCheckboxes.forEach(function(checkbox) {
      const seatLabel = checkbox.closest('.seat-label');

      if (seatLabel && checkbox.checked) {
        seatLabel.classList.add('seat-selected');
      }

      checkbox.addEventListener('change', function() {
        if (seatLabel) {
          seatLabel.classList.toggle('seat-selected', checkbox.checked);
        }
        updateTotalPrice();
      });
    });

    // Right-click context menu handler
    document.querySelectorAll('.seat-label[data-seat-id]').forEach(function(seatBtn) {
      seatBtn.addEventListener('contextmenu', function(e) {
        e.preventDefault();
        currentSeatId = seatBtn.getAttribute('data-seat-id');
        currentTicketId = seatBtn.getAttribute('data-ticket-id');
        contextMenu.style.display = 'block';
        contextMenu.style.left = e.pageX + 'px';
        contextMenu.style.top = e.pageY + 'px';
      });
    });

    // Hide context menu when clicking elsewhere
    document.addEventListener('click', function(e) {
      if (e.target.closest('.context-menu') || e.target.closest('[data-seat-id]')) {
        return;
      }
      contextMenu.style.display = 'none';
    });

    // Hide context menu on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        contextMenu.style.display = 'none';
      }
    });

    // Context menu action handlers
    document.querySelectorAll('.context-menu-item').forEach(function(item) {
      item.addEventListener('click', function() {
        const action = item.getAttribute('data-action');
        if (currentTicketId) {
          fetch(`/tickets/${currentTicketId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            },
            body: JSON.stringify({ ticket: { status: action } })
          })
          .then(response => {
            if (!response.ok) {
              return response.json().then(data => {
                throw new Error(data.errors ? data.errors.join(', ') : `HTTP ${response.status}`);
              });
            }
            return response.json();
          })
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert('Помилка: ' + (data.errors ? data.errors.join(', ') : 'Невідома помилка'));
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Помилка оновлення квитка: ' + error.message);
          });
        }
        contextMenu.style.display = 'none';
      });
    });

    updateTotalPrice();
  });
</script>

<style>
  .context-menu {
    position: fixed;
    background-color: #f3f3f3;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    padding: 4px 0;
    min-width: 150px;
    z-index: 1000;
  }

  .context-menu-item {
    padding: 8px 16px;
    cursor: pointer;
    user-select: none;
    font-size: 0.9rem;
    color: #333;
    transition: background-color 0.15s ease;
  }

  .context-menu-item:hover {
    background-color: #e3e3e3;
  }

  .context-menu-item:active {
    background-color: #d0d0d0;
  }
</style>
