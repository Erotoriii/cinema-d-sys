<div class="ticket-details-container">
  <h1>Ticket Details</h1>

  <div class="ticket-card">
    <p>
      <strong>Showtime:</strong>
      <%= link_to @ticket.showtime&.movie&.title, showtime_path(@ticket.showtime) if @ticket.showtime %>
    </p>

    <p>
      <strong>Date and Time:</strong>
      <%= @ticket.showtime&.start_time&.strftime("%B %d, %Y at %H:%M") %>
    </p>

    <p>
      <strong>Hall:</strong>
      <%= link_to @ticket.showtime&.hall&.name, hall_path(@ticket.showtime&.hall) if @ticket.showtime&.hall %>
    </p>

    <p>
      <strong>Seat:</strong>
      Row <%= @ticket.seat&.row %>, Seat <%= @ticket.seat&.number %>
    </p>

    <p>
      <strong>Status:</strong>
      <span class="status-badge status-<%= @ticket.status %>">
        <%= @ticket.status.upcase %>
      </span>
    </p>

    <p>
      <strong>Sold on Workday:</strong>
      <%= link_to @ticket.workday&.id, workday_path(@ticket.workday) if @ticket.workday %>
    </p>

    <p>
      <strong>Created at:</strong>
      <%= @ticket.created_at.strftime("%B %d, %Y at %H:%M") %>
    </p>
  </div>

  <div class="actions">
    <%= link_to "Edit", edit_ticket_path(@ticket), class: "btn btn-secondary" %>
    <%= button_to "Delete", ticket_path(@ticket), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
    <%= link_to "Back to Seat Map", new_ticket_path(showtime_id: @ticket.showtime_id), class: "btn btn-secondary" %>
  </div>
</div>


<style>
  .ticket-details-container {
    max-width: 600px;
    margin: 2rem auto;
    padding: 2rem;
  }

  .ticket-card {
    background: #f9f9f9;
    padding: 1.5rem;
    border-radius: 8px;
    margin: 1.5rem 0;
    border-left: 4px solid #2196F3;
  }

  .ticket-card p {
    margin: 1rem 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  .ticket-card strong {
    color: #333;
  }

  .status-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-weight: bold;
    color: white;
  }

  .status-sold {
    background-color: #f44336;
  }

  .status-pending {
    background-color: #ff9800;
  }

  .status-cancelled {
    background-color: #9e9e9e;
  }

  .actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-secondary {
    background-color: #6c757d;
    color: white;
  }

  .btn-secondary:hover {
    background-color: #5a6268;
  }

  .btn-danger {
    background-color: #f44336;
    color: white;
  }

  .btn-danger:hover {
    background-color: #da190b;
  }
</style>
